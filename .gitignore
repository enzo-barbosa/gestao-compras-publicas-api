# ============================================================
# GESTÃO DE COMPRAS PÚBLICAS — .gitignore
# ============================================================

# ---------- JAVA / MAVEN ----------
target/
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
!**/src/main/**/*.jar
!**/src/test/**/*.jar
*.war
*.nar
*.ear
hs_err_pid*
replay_pid*
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ---------- NODE / FRONTEND ----------
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
frontend/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------- IDEs ----------
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.apt_generated
.factorypath
.springBeans
.sts4-cache
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/
*.sublime-workspace
*.sublime-project

# ---------- AMBIENTE / SEGREDOS ----------
.env
.env.*
!.env.example
application-local.properties
application-local.yml
application-secret.properties

# ---------- LOGS / TEMP / SO ----------
logs/
*.log
tmp/
*.tmp
.DS_Store
Thumbs.db

# ---------- BUILD FRONTEND EXTRA ----------
build/
.eslintcache
.vite/

# ---------- MARKDOWN EXCETO README ----------
**/*.md
!README.md
HELP.md
