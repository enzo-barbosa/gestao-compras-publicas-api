# Copie para .env e preencha antes de subir o stack (docker compose -f docker-compose.prod.yml up -d).
# Gere um segredo forte com: openssl rand -base64 48

DB_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=cole-aqui-uma-chave-base64-de-48-bytes

# Imagens publicadas pelo CI no GitHub Container Registry
API_IMAGE=ghcr.io/OWNER/gestao-compras-api:latest
WEB_IMAGE=ghcr.io/OWNER/gestao-compras-web:latest
